# ============================================================
# Focus Guardian AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
# ============================================================

# Django Settings
DJANGO_SETTINGS_MODULE=focus_guardian.settings.development
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-get-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL - for production/docker)
DB_NAME=focus_guardian
DB_USER=focus_guardian
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# Focus Guardian Config
FOCUS_SCORE_PENALTY=5

# Email (production only)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@focusguardian.ai

# Admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@focusguardian.ai

# Sentry (production only)
SENTRY_DSN=

# Security (production only)
DJANGO_SECURE_SSL_REDIRECT=True
